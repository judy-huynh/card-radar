# Copy to .env and fill in. Never commit .env.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Notifications: pick ONE.
# Telegram: make a bot via @BotFather, paste token; send the bot a message, then run
#   python3 scan.py --chat-id   to print your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# or ntfy.sh: install the ntfy app, subscribe to a hard-to-guess topic, put it here.
NTFY_TOPIC=

# Dashboard base URL used in ntfy click links. Over Tailscale: http://bens-imac:8790
DASHBOARD_URL=http://localhost:8790
